# Secrets never go in git. The Groq key lives in n8n's encrypted credential store; .env is ignored as a safeguard.
.env
.env.*

# n8n local state (database, encrypted credentials, owner account), if ever bind-mounted here
n8n_data/

# Personal working files: kept locally only, not part of the submission
docs/PLAN.md
docs/AI_NOTES.md

# Per-request records are regenerated on every run; output/arcvault_output.json is the deliverable
output/records/*.json

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.log
